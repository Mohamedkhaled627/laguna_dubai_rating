generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Cafe {
  id          String   @id @default(cuid())
  name        String
  description String?
  address     String?
  coverImage  String?
  createdAt   DateTime @default(now())
  reviews     Review[]
}

model Review {
  id           String   @id @default(cuid())
  cafeId       String
  cafe         Cafe     @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  reviewerName String
  rating       Int
  comment      String?
  createdAt    DateTime @default(now())

  @@index([cafeId])
}